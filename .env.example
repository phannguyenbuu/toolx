# Supabase Configuration
SUPABASE_URL=http://YOUR_IP:8000
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
REACT_APP_SUPABASE_URL=http://YOUR_IP:8000
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# Environment
NODE_ENV=development
FLASK_ENV=development

# Python API URL (proxied via nginx on same IP)
REACT_APP_PYTHON_API_URL=http://YOUR_IP

# CORS Origins
CORS_ORIGIN=http://YOUR_IP,http://localhost:3000

# Build
GENERATE_SOURCEMAP=false
PUBLIC_URL=.
REACT_APP_BUILD_PATH=.
